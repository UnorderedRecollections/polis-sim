# Secrets — never commit (template is .env.example)
.env

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Container persistent state (gogs/gitea/woodpecker/postgres data dirs)
.state/

# Simulation state — generated at runtime; contains credentials
# (world.json) and matters. EXCEPTION: data/world/legal/ is SOURCE data
# (the legal-design YAML), tracked.
data/*
!data/world/
data/world/*
!data/world/legal/

# OS / editor cruft
.DS_Store

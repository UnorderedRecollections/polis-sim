# Local secrets for the git-law federation simulation. NEVER commit real values.
# Copy to .env and fill in. All scripts and the polis CLI read from .env.
#
# The dev rig is fronted by one proxy (task 0042, scripts/infra/proxy.sh):
#   http://localhost:10800/gogs|gitea|ci  (host side)
#   http://host.containers.internal:10800/... (the canonical URLs the
#   platforms render; run `scripts/infra/hosts.sh add` once so the host
#   browser resolves that name — needs sudo)

# Gogs (phase-1 platform) — admin personal access token.
# Obtain: gogs UI → user avatar → Settings → Applications → Generate New Token;
# or: curl -u <user>:<pass> -X POST http://localhost:10800/gogs/api/v1/users/<user>/tokens -d '{"name":"polis"}'
GOGS_API_KEY=

# Gitea (phase-2 platform) — the admin identity the bring-up script
# bootstraps headlessly (scripts/infra/gitea.sh creates the account and
# mints the token; no web installer). Neutral, project-owned identity —
# never a personal account.
GITEA_ADMIN_USERNAME=
GITEA_ADMIN_PASSWORD=
GITEA_ADMIN_EMAIL=

# Gitea — full-scope admin token. AUTO-MINTED by scripts/infra/gitea.sh
# (written into this file); regenerate by re-running the script with
# --force (or via the gitea UI as the GITEA_ADMIN_USERNAME user).
GITEA_API_KEY=

# Woodpecker CI — personal token of an admin user.
# Obtain: woodpecker UI (http://localhost:10800/ci) → user menu → Settings → API token.
WOODPECKER_API_KEY=

# Woodpecker ↔ Gitea OAuth application (server-side).
# Obtain: gitea UI → Settings → Applications → Add OAuth2 Application,
# redirect URI http://host.containers.internal:10800/ci/authorize
WOODPECKER_GITEA_CLIENT=
WOODPECKER_GITEA_SECRET=

# Postgres backing store (shared by gogs and gitea).
POSTGRES_PASSWORD=
